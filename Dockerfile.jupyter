# Jupyter Development Environment Dockerfile
FROM python:3.9-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY streamlit-app/requirements.txt /app/requirements.txt

# Install Jupyter and additional development packages
RUN echo "jupyterlab==4.0.9" >> /app/requirements.txt && \
    echo "jupyter==1.0.0" >> /app/requirements.txt && \
    echo "ipywidgets==8.1.1" >> /app/requirements.txt && \
    echo "nbconvert==7.12.0" >> /app/requirements.txt && \
    echo "voila==0.5.5" >> /app/requirements.txt

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy the entire project for development
COPY . /app/

# Create necessary directories
RUN mkdir -p /app/notebooks /app/outputs /app/logs

# Expose Jupyter port
EXPOSE 8888

# Default command
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
